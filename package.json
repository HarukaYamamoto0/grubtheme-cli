{
	"name": "grubtheme",
	"description": "A CLI tool that allows for previewing GRUB themes, using QEMU as a base",
	"version": "0.0.1",
	"scripts": {
		"start": "bun run src/index.ts",
		"prepublishOnly": "bun run build",
		"build": "bunx tsc",
		"lint": "bunx eslint . --ext .ts --cache --cache-strategy content",
		"lint:fix": "bunx eslint . --ext .ts --fix --cache --cache-strategy content",
		"format": "bunx prettier --check . --cache --cache-strategy content",
		"format:fix": "bunx prettier --write . --cache --cache-strategy content",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"commander": "^15.0.0",
		"qemu-img-ts": "^0.1.2"
	},
	"engines": {
		"bun": "1.3.14"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bun": "1.3.14",
		"@types/node": "^26.6.6",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.14.0",
		"jiti": "^2.7.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"author": {
		"name": "HarukaYamamoto0",
		"email": "harukayamamotodev@gmail.com",
		"url": "https://harukadev.com"
	},
	"license": "MIT",
	"homepage": "https://github.com/HarukaYamamoto0/grubtheme-cli#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HarukaYamamoto0/grubtheme-cli.git"
	},
	"bugs": {
		"url": "https://github.com/HarukaYamamoto0/grubtheme-cli/issues"
	}
}
